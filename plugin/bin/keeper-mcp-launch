#!/bin/sh
# Starts keeper's MCP server. When keeper is not installed it downloads the
# latest release, verifies it against the release's SHA256SUMS, installs it in
# ~/.local/bin and runs it. The checksum comes from the same release as the
# binary, so it guards against corruption and not against a compromised release.
# Any failure prints its reason on stderr and exits non-zero; nothing runs then.
set -eu

fail() {
    echo "keeper launcher: $*" >&2
    exit 1
}

bindir="${HOME:?}/.local/bin"
dest="$bindir/keeper"

# The oldest keeper this plugin works with. An older one would fail on
# `keeper mcp` with "unknown command".
min="0.1.0"

# older_than A B succeeds when version A is lower than version B. Only the
# leading digits and dots count, so a build like 0.1.0-3-gabc1234 is 0.1.0.
older_than() {
    a="${1%%[!0-9.]*}.0.0.0"
    b="${2%%[!0-9.]*}.0.0.0"
    for _ in 1 2 3; do
        x="${a%%.*}"
        y="${b%%.*}"
        a="${a#*.}"
        b="${b#*.}"
        [ "$x" -lt "$y" ] && return 0
        [ "$x" -gt "$y" ] && return 1
    done
    return 1
}

check_version() {
    have="$("$1" version 2>/dev/null | awk '$1 == "client" { print $2; exit }')" || have=""
    have="${have#v}"
    case "$min" in [0-9]*) ;; *) return 0 ;; esac
    case "$have" in [0-9]*) ;; *) return 0 ;; esac
    if older_than "$have" "$min"; then
        fail "keeper $have at $1 is older than the $min this plugin needs. Run \`keeper update\`, or download a release from https://github.com/mtch3n/keeper/releases, then restart."
    fi
}

# ~/.local/bin is where this launcher installs keeper, and it is often not on
# PATH. Run keeper from there anyway, and say how to put it on PATH so that
# `keeper connect` works in a terminal.
run() {
    case ":$PATH:" in
        *":$bindir:"*) ;;
        *) echo "keeper launcher: $bindir is not on your PATH. Add it for \`keeper connect\` to work in a terminal: export PATH=\"\$HOME/.local/bin:\$PATH\"" >&2 ;;
    esac
    bin="$1"
    shift
    check_version "$bin"
    exec "$bin" mcp "$@"
}

if command -v keeper >/dev/null 2>&1; then
    run keeper "$@"
fi
if [ -x "$dest" ]; then
    run "$dest" "$@"
fi

case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) fail "unsupported operating system $(uname -s): download a release from https://github.com/mtch3n/keeper/releases" ;;
esac
case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) fail "unsupported architecture $(uname -m): download a release from https://github.com/mtch3n/keeper/releases" ;;
esac

if command -v sha256sum >/dev/null 2>&1; then
    sha256() { sha256sum "$1" | cut -d ' ' -f 1; }
elif command -v shasum >/dev/null 2>&1; then
    sha256() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
else
    fail "neither sha256sum nor shasum is installed, so a download cannot be verified"
fi

base="https://github.com/mtch3n/keeper/releases/latest/download"
work="$(mktemp -d "${TMPDIR:-/tmp}/keeper-install.XXXXXX")" || fail "cannot make a temporary folder"
trap 'rm -rf "$work"' EXIT

fetch() {
    curl -fsSL --connect-timeout 15 --max-time 300 -o "$2" "$1" || fail "cannot download $1"
}

fetch "$base/SHA256SUMS" "$work/SHA256SUMS"
line="$(grep -E "keeper_[^ ]*_${os}_${arch}\.tar\.gz\$" "$work/SHA256SUMS" | head -n 1)" ||
    true
[ -n "$line" ] || fail "the latest release has no build for ${os}/${arch}"
want="${line%% *}"
asset="${line##*/}"
asset="${asset##* }"

fetch "$base/$asset" "$work/$asset"
got="$(sha256 "$work/$asset")"
[ "$got" = "$want" ] || fail "checksum mismatch for $asset: expected $want, got $got"

tar -xzf "$work/$asset" -C "$work" || fail "cannot unpack $asset"
src="$work/${asset%.tar.gz}/keeper"
[ -f "$src" ] || fail "$asset has no keeper binary"

mkdir -p "$bindir" || fail "cannot make $bindir"
tmp="$(mktemp "$bindir/.keeper.XXXXXX")" || fail "cannot write to $bindir"
cp "$src" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$dest" || {
    rm -f "$tmp"
    fail "cannot install $dest"
}

rm -rf "$work"
trap - EXIT
echo "keeper launcher: installed $asset to $dest" >&2
run "$dest" "$@"
